            "parameters": {
                "jsCode": "const t = new Date();\nt.setDate(t.getDate() - 1);\nconst y = t.getFullYear();\nconst m = String(t.getMonth() + 1).padStart(2, '0');\nconst d = String(t.getDate()).padStart(2, '0');\nreturn { timeMin: `${y}-${m}-${d}T00:00:00Z`, timeMax: `${y}-${m}-${d}T23:59:59Z` };"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                200,
                0
            ],
            "id": "fechas_ayer",
            "name": "Calcula Fechas de Ayer"
        },
        {
            "parameters": {
                "operation": "getAll",
                "calendar": {
                    "__rl": true,
                    "value": "atendejasolucoesautomaticas@gmail.com",
