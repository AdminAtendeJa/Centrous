            "id": "dbsupa",
            "name": "Traer Pacientes",
            "credentials": {
                "supabaseApi": {
                    "id": "htg0D9rHTCZDLrWM",
                    "name": "Supabase account"
                }
            }
        },
        {
            "parameters": {
                "jsCode": "const eventos = $('Turnos de Ayer').all();\nconst pacientes = $input.first().json;\nlet mensajes = [];\n\nfor (const e of eventos) {\n  const summary = e.json.summary || '';\n  // Filtrar solo los turnos que requieren atencion post-operatoria\n  const isCirugia = /extracci|implante|cirug|endodoncia|tratamiento/i.test(summary);\n  if (!isCirugia) continue;\n\n  // Buscar paciente\n  const p = pacientes.find(p => p.nombre && summary.toLowerCase().includes(p.nombre.toLowerCase()));\n  \n  if (p && p.telefono) {\n    mensajes.push({\n      telefono: p.telefono,\n      mensaje: `¡Hola ${p.nombre}! 🏥 Te contactamos del equipo médico de Schbelta Clinic. Queremos saber cómo te sientes hoy tras la intervención de ayer. Del 1 al 10, ¿cuánto dolor o molestia presentas? (Recuerda mantener dieta blanda o líquida).`\n    });\n  }\n}\nreturn mensajes;"
            },
            "type": "n8n-nodes-base.code",
            "typeVersion": 2,
            "position": [
                800,
                0
            ],
            "id": "cruza_post",
            "name": "Filtrar Cirugias y Mensaje"
        },
