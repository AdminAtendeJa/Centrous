                "instanceName": "=AtendeJa",
                "remoteJid": "={{ $json.telefono }}",
                "messageText": "={{ $json.mensaje }}",
                "options_message": {}
            },
            "type": "n8n-nodes-evolution-api.evolutionApi",
            "typeVersion": 1,
            "position": [
