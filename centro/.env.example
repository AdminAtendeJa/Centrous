# Centro — Variables de Entorno
# Copia este archivo como .env y completa tus valores
# NUNCA subas el .env a git

# === Backend ===
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173

# === Notion ===
NOTION_API_KEY=secret_xxxxxxxxxxxxxxxxxxxxx

# === n8n ===
N8N_URL=https://tu-instancia.app.n8n.cloud
N8N_API_KEY=n8n_api_xxxxxxxxxxxxxxxxxxxxx

# === Google OAuth (futuro) ===
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/google/callback

# === Supabase (Requerido para el Build del Frontend) ===
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# === AI & Integraciones ===
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxx

# === Meta Ads API (futuro) ===
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
