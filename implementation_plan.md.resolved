│   │   │   └── meta.routes.js
│   │   ├── controllers/       # Lógica de negocio separada de rutas
│   │   ├── middleware/        # Auth, error handler, logger
│   │   ├── services/          # Clientes de APIs externas
│   │   └── app.js
│   ├── Dockerfile
│   └── package.json
│
├── nginx/                     # Reverse proxy
│   └── nginx.conf
│
├── docker-compose.yml         # Orquestación completa
├── docker-compose.dev.yml     # Config de desarrollo local
├── .env.example               # Template de variables de entorno
└── README.md
```

