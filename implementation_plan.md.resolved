│   │   ├── hooks/             # Custom hooks (useNotion, useN8n…)
│   │   ├── store/             # Zustand stores por dominio
│   │   ├── services/          # Llamadas API centralizadas
│   │   ├── utils/             # Helpers puros (fechas, formateo…)
│   │   ├── constants/         # Rutas, configs, colores
